# Supabase — auth and database.
# Local stack: values printed by `npx supabase start`. Cloud: dashboard -> Settings -> API.
SUPABASE_URL=###
SUPABASE_KEY=###

# Supadata — YouTube transcript fetching. https://supadata.ai -> Dashboard -> API Keys
SUPADATA_API_KEY=###

# OpenRouter — LLM summarization. https://openrouter.ai -> Keys
OPENROUTER_API_KEY=###

# Bypasses RLS — server-only, never expose to the client.
# Needed by POST /api/account/delete (Worker runtime) and the offline `npm run grant-credits` script.
# Set as a Workers Secret in production too, or account deletion returns 503.
# The service_role key from `npx supabase status` (local) or dashboard -> Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=###
