# Supabase — auth and database.
# Local stack: values printed by `npx supabase start`. Cloud: dashboard -> Settings -> API.
SUPABASE_URL=###
SUPABASE_KEY=###

# Supadata — YouTube transcript fetching. https://supadata.ai -> Dashboard -> API Keys
SUPADATA_API_KEY=###

# OpenRouter — LLM summarization. https://openrouter.ai -> Keys
OPENROUTER_API_KEY=###

# Sentry — error monitoring. https://sentry.io -> Settings -> Client Keys (DSN)
# DELIBERATELY LEFT UNSET LOCALLY, and left commented out here so it stays that way by default.
# Both are optional in the `astro:env` schema, so an unset DSN leaves the SDK uninitialised — that
# absence, not a runtime flag, is what keeps local dev, the test suites, CI and e2e from reporting.
# Uncomment either one and your machine files REAL issues against the operator's project, mixed in
# with production traffic. In production: SENTRY_DSN is a Worker secret (`wrangler secret put`),
# PUBLIC_SENTRY_DSN is a BUILD input (a GitHub repo secret on the deploy job) because a client
# variable is inlined into the browser bundle at build time. They may carry the same DSN string.
# SENTRY_DSN=###
# PUBLIC_SENTRY_DSN=###

# Bypasses RLS — server-only, never expose to the client.
# Needed by POST /api/account/delete (Worker runtime) and the offline `npm run grant-credits` script.
# Set as a Workers Secret in production too, or account deletion returns 503.
# The service_role key from `npx supabase status` (local) or dashboard -> Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=###
