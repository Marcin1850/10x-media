# Required. Anthropic API key used by the Agent SDK. Every review run spends API credit.
ANTHROPIC_API_KEY=

# Optional. Model override (e.g. claude-opus-5). Leave unset to use the SDK's default model;
# the model actually used is always taken from the run's init message, never from this value.
REVIEW_MODEL=

# Optional. Maximum agent turns per review (positive integer). Default 5: one review turn plus room for
# structured-output retries. An invalid value refuses to start rather than falling back to the default.
REVIEW_MAX_TURNS=

# Optional. Spend cap per review in USD (positive number, e.g. 1.00). Unset means no cap. Hitting the cap ends
# the run as an agent error (exit 2), never as a review.
REVIEW_MAX_BUDGET_USD=
