{
  "name": "code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diff-only code-review agent on the Claude Agent SDK — no tools, no inherited settings, zod-validated JSON findings.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "review": "tsx --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
