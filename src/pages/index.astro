---
import Welcome from "@/components/Welcome.astro";
import Layout from "@/layouts/Layout.astro";
import { copy } from "@/lib/copy";

const deleted = Astro.url.searchParams.get("deleted") === "1";
---

<Layout>
  {
    deleted ? (
      <div role="status" class="fixed inset-x-0 top-0 z-50 flex justify-center px-4 py-3 text-sm">
        <div class="bg-card text-card-foreground border-border rounded-full border px-4 py-2">
          {copy.landing.deletedToast}
        </div>
      </div>
    ) : null
  }
  <Welcome />
</Layout>
