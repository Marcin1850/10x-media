---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getBalance } from "@/lib/services/credits";
import GenerateSummaryForm from "@/components/summaries/GenerateSummaryForm";

const { user } = Astro.locals;

// RLS-scoped read of the signed-in user's own credit balance. `null` when the row is missing,
// Supabase isn't configured, or the read failed — rendered as "—" below rather than a misleading 0.
let credits: number | null = null;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    try {
      // createClient returns supabase-js's default untyped client (no generated Database types yet),
      // so passing it where the service expects its explicit shapes is an unavoidable `any` gap.
      // eslint-disable-next-line @typescript-eslint/no-unsafe-argument
      credits = await getBalance(supabase, user.id);
    } catch (err) {
      // Display-only: this balance is never the enforcement gate (that lives in the generation
      // endpoint, where getBalance must keep throwing), so a DB blip must not fail the page.
      // eslint-disable-next-line no-console
      console.error("dashboard: credit balance read failed", err);
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <div class="mt-6 border-t border-white/10 pt-6">
        <GenerateSummaryForm client:load initialCredits={credits} />
      </div>
      <a
        href="/account"
        class="mt-6 inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
      >
        Account settings
      </a>
      <form method="POST" action="/api/auth/signout" class="mt-4">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
