---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { copy } from "@/lib/copy";

const error = Astro.url.searchParams.get("error");
---

<Layout title={copy.auth.signUp.heading}>
  <div class="flex min-h-[calc(100vh-3.5rem)] items-center justify-center p-4">
    <div class="bg-card text-card-foreground border-border w-full max-w-sm rounded-2xl border p-8">
      <h1 class="font-display text-foreground mb-6 text-center text-2xl font-semibold">
        {copy.auth.signUp.heading}
      </h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        {copy.auth.signUp.haveAccount}{" "}
        <a href="/auth/signin" class="text-primary hover:underline">{copy.auth.signUp.signInLink}</a>
      </p>
    </div>
  </div>
</Layout>
