---
import Layout from "@/layouts/Layout.astro";
import { copy } from "@/lib/copy";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed ? copy.auth.confirmEmail.autoConfirmed : copy.auth.confirmEmail.pending;
---

<Layout title={content.heading}>
  <div class="flex min-h-[calc(100vh-3.5rem)] items-center justify-center p-4">
    <div class="bg-card text-card-foreground border-border w-full max-w-sm rounded-2xl border p-8 text-center">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="font-display text-foreground mb-3 text-2xl font-semibold">
        {content.heading}
      </h1>
      <p class="text-muted-foreground mb-6">{content.description}</p>
      <a href="/auth/signin" class="text-primary text-sm hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
