---
import Layout from "@/layouts/Layout.astro";
import DeleteAccountDialog from "@/components/account/DeleteAccountDialog";
import { TopUpAction } from "@/components/account/TopUpAction";
import { copy } from "@/lib/copy";

const { user, credits } = Astro.locals;
---

<Layout title={copy.account.heading}>
  <div class="flex min-h-[calc(100vh-3.5rem)] items-center justify-center p-4">
    <div class="w-full max-w-lg space-y-6">
      <div class="bg-card text-card-foreground border-border rounded-2xl border p-8">
        <h1 class="font-display text-foreground text-2xl font-semibold">{copy.account.heading}</h1>
        <p class="text-muted-foreground mt-2 text-sm">
          {copy.account.signedInAs(user?.email ?? "")}
        </p>

        <div class="border-border mt-6 flex items-start justify-between border-t pt-6">
          <div class="text-muted-foreground flex items-center gap-2 text-sm">
            <span>{copy.account.creditsLabel}</span>
            {
              credits === null ? (
                <>
                  <span class="bg-muted h-4 w-8 animate-pulse rounded" aria-hidden="true" />
                  <span class="sr-only">{copy.nav.creditsUnavailable}</span>
                </>
              ) : (
                <span class="text-foreground font-medium" data-credit-balance>
                  {credits}
                </span>
              )
            }
          </div>
          <TopUpAction client:load />
        </div>
      </div>

      <div class="border-destructive/30 bg-destructive/10 rounded-2xl border p-8">
        <h2 class="text-destructive text-xl font-bold">{copy.account.dangerZone.heading}</h2>
        <p class="text-foreground/80 mt-2 text-sm">
          {copy.account.dangerZone.description}
        </p>
        <div class="mt-5">
          <DeleteAccountDialog client:load email={user?.email ?? ""} />
        </div>
      </div>
    </div>
  </div>
</Layout>
