---
import Layout from "@/layouts/Layout.astro";
import DeleteAccountDialog from "@/components/account/DeleteAccountDialog";

const { user } = Astro.locals;
---

<Layout title="Account">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg space-y-6">
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Account
        </h1>
        <p class="mt-2 text-sm text-blue-100/80">
          Signed in as <span class="font-semibold text-white">{user?.email}</span>
        </p>
        <a
          href="/dashboard"
          class="mt-4 inline-block text-sm text-blue-200 underline underline-offset-4 hover:text-white"
        >
          ← Back to dashboard
        </a>
      </div>

      <div class="rounded-2xl border border-red-500/30 bg-red-950/20 p-8 text-white backdrop-blur-xl">
        <h2 class="text-xl font-bold text-red-300">Danger zone</h2>
        <p class="mt-2 text-sm text-blue-100/70">
          Permanently delete your account and all associated data. This cannot be undone.
        </p>
        <div class="mt-5">
          <DeleteAccountDialog client:load email={user?.email ?? ""} />
        </div>
      </div>
    </div>
  </div>
</Layout>
