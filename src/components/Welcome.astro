---
import { copy } from "@/lib/copy";

const { user } = Astro.locals;
---

<div class="relative min-h-[calc(100vh-3.5rem)] w-full">
  <div class="p-4 sm:p-8">
    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <p class="text-muted-foreground mb-4 text-sm font-medium tracking-wide uppercase">{copy.landing.tagline}</p>
      <h1 class="font-display text-foreground mb-6 text-5xl leading-tight font-bold sm:text-6xl lg:text-7xl">
        10xMedia
      </h1>
      <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
        {copy.landing.heroDescription}
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        {
          user ? (
            <a
              href="/summaries"
              class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
            >
              {copy.landing.ctaSummaries}
            </a>
          ) : (
            <>
              <a
                href="/auth/signin"
                class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
              >
                {copy.nav.signIn}
              </a>
              <a
                href="/auth/signup"
                class="border-border text-foreground hover:bg-accent inline-flex items-center justify-center rounded-lg border px-6 py-3 text-base font-medium transition-colors"
              >
                {copy.nav.signUp}
              </a>
            </>
          )
        }
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="bg-card text-card-foreground border-border rounded-xl border p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground mb-4"
        >
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
          <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
          <path d="M16 13H8"></path>
          <path d="M16 17H8"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold">{copy.landing.features.read.heading}</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          {copy.landing.features.read.description}
        </p>
      </div>

      <div class="bg-card text-card-foreground border-border rounded-xl border p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground mb-4"
        >
          <line x1="21" x2="14" y1="4" y2="4"></line>
          <line x1="10" x2="3" y1="4" y2="4"></line>
          <line x1="21" x2="12" y1="12" y2="12"></line>
          <line x1="8" x2="3" y1="12" y2="12"></line>
          <line x1="21" x2="16" y1="20" y2="20"></line>
          <line x1="12" x2="3" y1="20" y2="20"></line>
          <line x1="14" x2="14" y1="2" y2="6"></line>
          <line x1="8" x2="8" y1="10" y2="14"></line>
          <line x1="16" x2="16" y1="18" y2="22"></line>
        </svg>
        <h3 class="mb-2 text-lg font-semibold">{copy.landing.features.tuned.heading}</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          {copy.landing.features.tuned.description}
        </p>
      </div>

      <div class="bg-card text-card-foreground border-border rounded-xl border p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground mb-4"
        >
          <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold">{copy.landing.features.library.heading}</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          {copy.landing.features.library.description}
        </p>
      </div>
    </div>
  </div>
</div>
